  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frostime/pi-mail.git"
  },
  "homepage": "https://github.com/frostime/pi-mail#readme",
  "bugs": {
    "url": "https://github.com/frostime/pi-mail/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
